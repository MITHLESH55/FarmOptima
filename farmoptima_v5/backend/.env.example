# Auth — CHANGE THIS for any real deployment. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate limit on the expensive /api/recommend endpoint (runs NSGA-II)
RECOMMEND_RATE_LIMIT=20/minute

# Database — SQLite by default (zero setup). To use PostgreSQL instead:
# DATABASE_URL=postgresql://user:password@localhost:5432/farmoptima
DATABASE_URL=sqlite:///./farmoptima.db

# Google Earth Engine — register at https://earthengine.google.com/
# Leave blank to use deterministic mock NDVI until you've set this up.
GEE_PROJECT=farmoptima-2026

# Optional weather forecast supplement — https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Genetic algorithm tuning (defaults are sensible; raise for more thorough search)
GPO_POPULATION_SIZE=40
GPO_GENERATIONS=60

# ---------------------------------------------------------------------------
# AI Assistant (Phase 2 Step 2.1)
# ---------------------------------------------------------------------------

# LLM provider — Groq is the default for FarmOptima production.
# The application remains provider-neutral; both "groq" and "openai" are
# supported by the same OpenAI-compatible transport abstraction.
LLM_PROVIDER=groq

# Provider-neutral API key — set this to your Groq key for production use.
# Leave blank to disable the assistant (calls will return HTTP 502 with a
# clear error message — no silent fallback).
LLM_API_KEY=

# Groq-compatible model.  This value is configurable and should be set to a
# model currently supported by your Groq account.
LLM_MODEL=llama-3.3-70b-versatile

# OpenAI-compatible base URL for Groq.  This preserves the existing client
# abstraction while pointing at the Groq chat endpoint.
LLM_BASE_URL=https://api.groq.com/openai/v1

# Grounding strictness — MUST be True for any farmer-facing deployment.
# Set to False ONLY for local debugging (logs a warning but returns the
# model's answer even if it fails the grounding check).
AI_GROUNDING_STRICT=True

# ---------------------------------------------------------------------------
# Voice Assistant (Phase 2 Step 2.4)
# ---------------------------------------------------------------------------
# STT model name (OpenAI Whisper)
STT_MODEL=whisper-1

# TTS model and voice (OpenAI TTS)
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Maximum audio upload size (bytes) — default 25MB
VOICE_MAX_AUDIO_SIZE_BYTES=26214400
